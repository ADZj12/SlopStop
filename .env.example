# ============================================================
# SLOPSTOP env template. SAFE TO COMMIT.
# Copy this to .env and fill real values there.
# .env is git ignored and must never be pushed.
# ============================================================

# Model provider key. ONLY needed for Loop 2 (elicitation),
# which generates new hallucinated names. The core checker and
# the Loop 1 flip monitor do NOT need any key and hit only
# public package registries.
ANTHROPIC_API_KEY=

# Where local state lives. Defaults to ~/.slopstop if unset.
# This directory holds the corpus database and is never committed.
SLOPSTOP_DATA_DIR=

# Telemetry is OFF by default and stays off unless set to 1.
# A security tool must not phone home silently. Opt in only.
SLOPSTOP_TELEMETRY=0

# Network timeout in seconds for registry lookups.
SLOPSTOP_HTTP_TIMEOUT=8
